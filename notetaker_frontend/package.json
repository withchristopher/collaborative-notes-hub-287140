{
  "name": "notetaker-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "User interface for the self-hosted notetaking application, enabling note management and collaboration.",
  "scripts": {
    "dev": "next dev -p ${NEXT_PUBLIC_PORT:-3000}",
    "build": "next build",
    "start": "next start -p ${NEXT_PUBLIC_PORT:-3000}",
    "lint": "next lint",
    "type-check": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18.18.0 <21"
  },
  "dependencies": {
    "next": "14.2.7",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.11.30",
    "@types/react": "18.2.66",
    "@types/react-dom": "18.2.22",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.7",
    "typescript": "5.6.3"
  }
}
